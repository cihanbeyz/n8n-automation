      "parameters": {
        "jsCode": "// Normalise whichever branch we came from into one clean shape.\nconst c = $input.first().json;\nconst contactId = c.id || c.contact?.id || (c.contacts && c.contacts[0] && c.contacts[0].id);\n\nreturn [{\n  json: {\n    ...$('Build Time-Aware Message').first().json,\n    contactId\n  }\n}];"
