    {
      "parameters": {
        "jsCode": "// Accepts either a GHL conversation-provider webhook or a raw Twilio inbound SMS webhook.\nconst b = $input.first().json.body || $input.first().json;\n\nconst text = (b.body || b.message?.body || b.Body || '').trim();\nconst contactId = b.contactId || b.contact_id || null;\nconst phone = b.phone || b.From || b.contact?.phone || '';\nconst lower = text.toLowerCase();\n\nlet intent = 'general';\nif (/emergenc|no heat|no cool|no ac|leak|flood|smoke|gas smell/.test(lower)) intent = 'emergency';\nelse if (/repair|fix|broken|not working/.test(lower)) intent = 'repair';\nelse if (/install|new system|replace|quote|estimate/.test(lower)) intent = 'install';\nelse if (/maintenance|tune.?up|service plan|check.?up/.test(lower)) intent = 'maintenance';\n\nreturn [{\n  json: { rawText: text, intent, contactId, phone, receivedAt: new Date().toISOString() }\n}];"
      },
      "id": "code_parse_intent",
      "name": "Parse Reply Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1160, 700]
    },
