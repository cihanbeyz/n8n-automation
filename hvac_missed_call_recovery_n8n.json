      "parameters": {
        "jsCode": "// unreadMessageCount / lastMessageDirection differ by GHL response shape;\n// this checks the conversation for any inbound message after our outbound send.\nconst c = $input.first().json;\nconst conv = (c.conversations && c.conversations[0]) || c;\nconst hasInboundReply = (conv.lastMessageType || conv.lastMessageDirection || '').toLowerCase().includes('inbound')\n  || (conv.unreadCount || 0) > 0;\n\nreturn [{ json: { ...$('Resolve Contact ID').first().json, hasInboundReply } }];"
      },
